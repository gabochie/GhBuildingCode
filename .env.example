# ---- Server (never expose) ----
# Auth
AUTH_SECRET=change-me-32-chars-minimum
JWT_EXPIRES_IN=7d
# AI — Primary (free tier: Google Gemini 15 RPM / 1M tokens/day)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_EMBED_MODEL=
# AI — Fallback (paid: OpenRouter / OpenAI / etc.)
AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=openai/gpt-4o-mini
# Admin bootstrap
GHBC_ADMIN_EMAIL=admin@ghbc.gabochie.com
GHBC_ADMIN_PASSWORD=change-me
# Corpus (optional override)
BCGH_CORPUS=C:\Users\user\Desktop\BCGH\ghbc-corpus
# Deployment
NODE_ENV=production
APP_URL=https://ghbc.gabochie.com
# Twilio (phone voice agent — optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Brevo email (transactional — required for password-reset emails)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@ghbc.gabochie.com
BREVO_SENDER_NAME=GHBC

# Ghana payments (all optional — gateway appears in checkout only when configured)
# Moolre (mobile-money aggregator: MTN / Telecel / AirtelTigo MoMo)
MOOLRE_API_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=
MOOLRE_BASE_URL=https://api.moolre.com
# ExpressPay Ghana Pay (cards + mobile money + gh-link)
EXPRESSPAY_MERCHANT_ID=
EXPRESSPAY_API_KEY=
EXPRESSPAY_BASE_URL=https://expresspaygh.com/api

# Cron maintenance (auto-renewal sweep: expires lapsed subscriptions and flags
# subs due for renewal). Shared secret the Worker's `scheduled` handler sends in
# the `x-cron-secret` header to POST /api/v1/cron/billing. Optional — the sweeps
# simply no-op when unset. Run: wrangler secret put CRON_SECRET
CRON_SECRET=

# Analytics (optional, privacy-first). Set to your Plausible shared domain to
# enable pageviews + custom conversion-goal tracking; leave blank to load nothing.
# At plausible.io, add a site for ghbc.gabochie.com and set this to the site's
# domain value (e.g. "ghbc.gabochie.com").
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

